# ======================================
# PRODUCTION CONFIGURATION TEMPLATE
# ======================================
#
# Hướng dẫn: Copy file này thành .env và cập nhật các giá trị
# cp .env.production.example .env

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Client URL (for CORS) - Thay đổi thành domain của bạn
CLIENT_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com

# JWT Secret - PHẢI THAY ĐỔI trong production!
# Tạo secret mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vuotvumon
DB_USER=vuotvumon_user
DB_PASSWORD=your_secure_password_here

# Session Secret - PHẢI THAY ĐỔI trong production!
# Tạo secret mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-super-secret-session-key-change-in-production

# OAuth (Optional - để trống nếu không dùng)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://your-domain.com/api/auth/facebook/callback
